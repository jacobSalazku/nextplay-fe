# Copy to .env.local and fill in real values. .env* is gitignored.

# Backend GraphQL endpoint (server-only — never exposed to the client).
BACKEND_GRAPHQL_URL="http://localhost:3001/graphql"

# next-auth cookie encryption secret. Generate: openssl rand -hex 32
# NEXTAUTH_SECRET is accepted as an alias.
AUTH_SECRET=

# Base URL next-auth builds callback/redirect URLs from.
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials. Omit both to run with dev-login only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to "true" to enable the email-only dev login. Ignored in production.
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_DEV_AUTH_ENABLED=false

# Base URL used for Open Graph / metadata (optional).
NEXT_BASE_URL="http://localhost:3000/"
